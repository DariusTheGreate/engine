{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake configure (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", ".",
                "-B", "build-mac",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
            ],
            "problemMatcher": [],
            "detail": "Configure the CMake project into build-mac (Debug + compile_commands.json)"
        },
        {
            "label": "CMake build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build-mac",
                "-j8"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Build the DEAN engine (Cmd+Shift+B)"
        },
        {
            "label": "CMake clean",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build-mac",
                "--target", "clean"
            ],
            "problemMatcher": [],
            "detail": "Clean build artifacts in build-mac"
        }
    ]
}
